# ==============================
# 运行
# ==============================
# development | test | production。production 与 test 启动时不读本文件。
NODE_ENV=development
# 127.0.0.1 仅本机；0.0.0.0 监听全部网卡。
HOST=127.0.0.1
# 1..65535 的整数，缺省 3000。
PORT=3000
# fatal | error | warn | log | debug | verbose，从严重到详细。
LOG_LEVEL=log

# ==============================
# 观测（可选）
# ==============================
# true | false，缺省 false。为 true 时必须同时填写下面两项，才会加载 SDK。
OBSERVE_ENABLED=false
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# ==============================
# 数据库
# ==============================
# MySQL 连接串。Prisma CLI 与运行时共用；密码含特殊字符须 URL 编码。不要提交真实值。
DATABASE_URL="mysql://app_user:replace_me@127.0.0.1:3306/init_xue_dev"

# Redis 只保存登录来源的计数键，不保存会话、权限或密码。
REDIS_URL=redis://127.0.0.1:6379

# ==============================
# 接口文档
# ==============================
# true | false，缺省 false。
SWAGGER_ENABLE=false
# 非空路径，缺省 api/docs。
SWAGGER_PATH=api/docs

# ==============================
# 认证
# ==============================
# Access 签名密钥。至少 32 个字符，无默认值。不要提交真实密钥。
JWT_SECRET=replace_me_with_at_least_32_characters
# 签发者，须非空，写入并校验 Access 的 iss。
JWT_ISSUER=init-xue
# 接收方，须非空，写入并校验 Access 的 aud。
JWT_AUDIENCE=init-xue-api
# Access 有效期（秒）。1..86400，缺省 900（15 分钟），且必须小于刷新有效期。
JWT_ACCESS_TTL_SECONDS=900
# 刷新有效期（秒）。1..2592000，缺省 604800（7 天）。
REFRESH_TTL_SECONDS=604800
# 会话绝对上限（秒）。1..2592000，缺省 2592000（30 天），且必须大于或等于刷新有效期。
SESSION_MAX_TTL_SECONDS=2592000
# 登录限流 HMAC。至少 32 个字符，无默认值。不要提交真实密钥。
AUTH_LIMIT_HMAC_SECRET=replace_me_with_at_least_32_characters
# 同一用户名每窗口最多尝试次数。1..1000，缺省 10。
AUTH_ACCOUNT_MAX_ATTEMPTS=10
# 用户名计数窗口（秒）。1..86400，缺省 900（15 分钟）。
AUTH_ACCOUNT_WINDOW_SECONDS=900
# 同一来源地址每窗口最多尝试次数。1..10000，缺省 60。
AUTH_IP_MAX_ATTEMPTS=60
# 来源地址计数窗口（秒）。1..3600，缺省 60。
AUTH_IP_WINDOW_SECONDS=60

# ==============================
# HTTP 边界
# ==============================
# 浏览器来源，逗号分隔，只写协议、主机和端口。留空表示不开放跨域。
CORS_ORIGINS=
# JSON 请求体上限（字节）。1024..1048576，缺省 1048576。
JSON_BODY_LIMIT_BYTES=1048576
# 反向代理跳数。1..5；留空表示不信任 X-Forwarded-*。登录来源仍看套接字地址。
TRUSTED_PROXY=

# ==============================
# 定时清理
# ==============================
# true | false，缺省 false。为 true 时本进程每小时整点（UTC）删除一批过期数据。
# 只让一个进程打开。未到会话绝对寿命的记录不会删除。
SCHEDULE_ENABLED=false

# ==============================
# 文件上传
# ==============================
# true | false，缺省 false。为 true 时才注册上传和下载，并要求 UPLOAD_ROOT。
UPLOAD_ENABLED=false
# 单个文件上限（字节）。1..5242880，缺省 5242880。
UPLOAD_MAX_BYTES=5242880
# 项目目录之外的绝对路径。只在 UPLOAD_ENABLED=true 时使用。
UPLOAD_ROOT=
