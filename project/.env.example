NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=log

# 默认关闭；启用时必须同时提供凭据。
OBSERVE_ENABLED=false
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# CLI 与运行时共用；密码若含特殊字符须 URL 编码。不要提交真实值。
DATABASE_URL="mysql://app_user:replace_me@127.0.0.1:3306/init_xue_dev"

# 默认关闭；路径非空。
SWAGGER_ENABLE=false
SWAGGER_PATH=api/docs

# 至少 32 个字符，无默认值。不要提交真实密钥。
JWT_SECRET=replace_me_with_at_least_32_characters
JWT_ISSUER=init-xue
JWT_AUDIENCE=init-xue-api
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800
