
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ==============================
// 用户表
// ==============================

model User {
  id          Int       @id @default(autoincrement())
  username    String?   @unique @db.VarChar(50)
  password    String?   @db.VarChar(255) // 仅存密码哈希
  nickname    String?    @db.VarChar(50)
  avatar      String?   @db.VarChar(255)
  email       String    @unique @db.VarChar(100)
  phone       String?   @unique @db.VarChar(20)
  sex         Int?      @db.TinyInt // 0=未知 1=男 2=女
  status       Int       @default(1) @db.TinyInt // 1=启用 0=禁用
  tokenVersion Int       @default(0) @map("token_version")
  lastLoginAt DateTime? @map("last_login_at")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime?  @updatedAt @map("updated_at")

  // 关联关系
  roles     UserRole[]
  sessions  UserSession[]
  auditLogs AuditLog[]
  files     StoredFile[]

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

// ==============================
// 角色表
// ==============================

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(50)
  code        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  status      Int      @default(1) @db.TinyInt // 1=启用 0=禁用
  isSystem    Boolean  @default(false) @map("is_system") // 种子维护的系统角色，接口不能删除、禁用或改编码
  sort        Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  // 关联关系
  users       UserRole[]
  permissions RolePermission[]

  @@index([status])
  @@map("roles")
}

// ==============================
// 用户角色关联表
// ==============================

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  // 关联关系
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// ==============================
// 权限类型
// ==============================

enum PermissionType {
  DIRECTORY // 目录
  MENU      // 菜单
  BUTTON    // 按钮
  API       // 接口
}

// ==============================
// 权限表
// ==============================

model Permission {
  id          Int            @id @default(autoincrement())
  parentId    Int?           @map("parent_id")
  name        String         @db.VarChar(100)
  code        String         @unique @db.VarChar(100)
  type        PermissionType
  resource    String?        @db.VarChar(255)
  description String?        @db.VarChar(255)
  status      Int            @default(1) @db.TinyInt // 1=启用 0=禁用
  sort        Int            @default(0)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // 权限树形结构
  parent   Permission?  @relation("PermissionTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Permission[] @relation("PermissionTree")

  // 关联角色
  roles RolePermission[]

  @@index([parentId])
  @@index([type, status])
  @@map("permissions")
}

// ==============================
// 角色权限关联表
// ==============================

model RolePermission {
  id           Int      @id @default(autoincrement())
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // 关联关系
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ==============================
// 用户登录会话表
// ==============================

model UserSession {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  deviceName       String?   @map("device_name") @db.VarChar(100)
  ipAddress        String?   @map("ip_address") @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.VarChar(500)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // 关联关系
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sys_user_session")
}

// 一次刷新一条记录。会话行仍只指向当前摘要，历史摘要留在这里做重放检测。
model RefreshToken {
  id        Int       @id @default(autoincrement())
  sessionId Int       @map("session_id")
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  session UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, expiresAt])
  @@index([expiresAt])
  @@map("sys_refresh_token")
}

// 登录尝试的固定窗口计数。键是 HMAC，不保存用户名或 IP 原文。
model AuthAttemptBucket {
  keyHash     String   @map("key_hash") @db.Char(64)
  windowStart DateTime @map("window_start") @db.DateTime(0)
  attempts    Int      @default(1)
  expiresAt   DateTime @map("expires_at") @db.DateTime(3)

  @@id([keyHash, windowStart])
  @@index([expiresAt])
  @@map("auth_attempt_buckets")
}

// 关键写操作的审计。只记操作者、动作、对象和 requestId，不记密码、哈希或令牌。
// 运行时不更新、不删除这些行。操作者被物理删除前必须先处理审计，所以外键是 Restrict。
model AuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int?     @map("actor_user_id")
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  action      String   @db.VarChar(64)
  targetType  String   @map("target_type") @db.VarChar(32)
  targetId    String   @map("target_id") @db.VarChar(64)
  requestId   String   @map("request_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// 上传文件的元数据。磁盘路径只由服务端生成的 storageKey 决定，不保存原始路径。
// 物理删除用户前必须先处理这些行，所以外键是 Restrict。
model StoredFile {
  id           String    @id @default(uuid()) @db.VarChar(36)
  ownerId      Int       @map("owner_id")
  owner        User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  storageKey   String    @unique @map("storage_key") @db.VarChar(255)
  originalName String    @map("original_name") @db.VarChar(255)
  mimeType     String    @map("mime_type") @db.VarChar(100)
  sizeBytes    Int       @map("size_bytes")
  deletedAt    DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@index([ownerId, deletedAt, createdAt])
  @@map("stored_files")
}
